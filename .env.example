# Supabase (จาก Project Settings > API)
# คีย์ 2 ตัวนี้ปลอดภัยต่อ client (อยู่ภายใต้ RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# คัดลอกเป็น .env.local แล้วใส่ค่าจริง
# ห้ามใส่ service_role key ลงไฟล์นี้ (ผู้ใช้ภายนอกไม่ควรเห็น)

# IMPORTANT:
# - เปิดใช้งาน RLS โดยรันไฟล์ใน supabase/migrations/ ทุกไฟล์
#   (202609230000_maintenance_rls.sql + 202609230001_rls_hardening.sql)
# - ฟีเจอร์ความปลอดภัยทั้งหมด (RBAC ตาม role) ขึ้นอยู่กับ RLS เหล่านี้